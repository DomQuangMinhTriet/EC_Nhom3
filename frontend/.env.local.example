# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Backend API
NEXT_PUBLIC_API_URL=http://localhost:8080

# Server-only: must match backend's EC_VOUCHER_API_KEY. Used by
# /api/payments/confirm to call the internal PUT /api/orders/:id (payment
# callback) endpoint. Never prefix this with NEXT_PUBLIC_ — it must not reach
# the browser bundle.
EC_VOUCHER_API_KEY=

# Cloudinary
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
