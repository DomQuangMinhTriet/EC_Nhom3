# App
PORT=8080
NODE_ENV=development
JWT_SECRET_KEY=replace-with-a-long-random-secret
FRONTEND_ORIGIN=http://localhost:3000

# Database (Supabase Postgres) — used by Drizzle
DB_HOST=db.your-project-ref.supabase.co
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres
DB_PASS=yourpassword
DB_SSL=true

# Optional single connection string, used when present
# DATABASE_URL=postgresql://postgres:yourpassword@db.your-project-ref.supabase.co:5432/postgres

# Supabase Auth
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# Cloudinary (ảnh voucher, avatar)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Internal API key for protected service-to-service notification endpoints
EC_VOUCHER_API_KEY=replace-with-a-long-random-api-key

# SePay / VietQR bank transfer demo config.
# These values are display/payment metadata. Use real values only in private env files.
SEPAY_BANK_ACCOUNT=0123456789
SEPAY_BANK_NAME=MBBank
SEPAY_ACCOUNT_NAME=EC VOUCHER DEMO
SEPAY_WEBHOOK_API_KEY=replace-with-sepay-webhook-api-key

# PayPal Sandbox (Orders API v2). See docs/payment-integration/paypal-sandbox.md
PAYPAL_CLIENT_ID=replace-with-paypal-sandbox-client-id
PAYPAL_CLIENT_SECRET=replace-with-paypal-sandbox-client-secret
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com

# VNPay Sandbox (redirect + HMAC-SHA512). See docs/payment-integration/vnpay-sandbox.md
VNPAY_TMN_CODE=replace-with-vnpay-sandbox-tmn-code
VNPAY_HASH_SECRET=ABCDEF1234567890

# Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
VNPAY_PAYMENT_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html

# Public frontend domain, used to build PayPal/VNPay return URLs (no trailing slash)
APP_BASE_URL=http://localhost:3000

# Supabase Edge Function used by POST /api/notifications/email
# The function should accept { "email": string, "title": string, "body": string }
# Edge Function secrets are configured in Supabase, not in this backend .env:
# RESEND_API_KEY=your-resend-api-key
# EMAIL_FROM="EC Voucher <notifications@your-domain.com>"
SUPABASE_EMAIL_FUNCTION_NAME=send-email
